---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const links = [
  {
    href: "https://open.spotify.com/artist/2dmceYZmb1Br8rTXBGa510",
    label: "Spotify",
  },
  {
    href: "https://music.apple.com/ca/artist/alec-ray-sherman/1254102346",
    label: "Apple Music",
  },
  { href: "https://www.youtube.com/@alecraysherman", label: "YouTube" },
  {
    href: "https://www.instagram.com/alec.ray.sherman",
    label: "Instagram",
  },
];
---

<ul class={`flex flex-wrap gap-5 text-sm ${className}`}>
  {
    links.map((l) => (
      <li>
        <a
          class="underline-offset-4 hover:underline"
          href={l.href}
          target="_blank"
          rel="noreferrer"
        >
          {l.label}
        </a>
      </li>
    ))
  }
</ul>
