---
import SocialLinks from "./SocialLinks.astro";
---

<footer
  id="contact"
  class="mt-24 border-t border-neutral-200"
  style="background-color: #fef6ed;"
>
  <div class="mx-auto max-w-6xl px-6 py-14">
    <h2
      class="text-2xl font-normal tracking-wide"
      style="font-family: 'Questrial', system-ui, sans-serif;"
    >
      Contact information
    </h2>
    <div class="mt-6 space-y-2 text-base">
      <p>
        <a
          class="hover:underline"
          href="mailto:murdermysteryrecordings@gmail.com"
        >
          murdermysteryrecordings@gmail.com
        </a>
      </p>
      <p>
        <a class="hover:underline" href="tel:+16479930884">647-993-0884</a>
      </p>
    </div>
    <div class="mt-8">
      <SocialLinks />
    </div>
  </div>
  <div
    class="border-t border-neutral-200 px-6 py-4 text-center text-xs text-neutral-500"
  >
    &copy; {new Date().getFullYear()} Alec Ray Sherman.
  </div>
</footer>
