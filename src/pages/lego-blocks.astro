---
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import cover from "../assets/lego-blocks-cover.jpg";

const ogImage = await getImage({ src: cover, width: 1200, format: "jpg" });

const listenLinks = [
  {
    label: "Spotify",
    href: "https://open.spotify.com/album/1F3Q7eA85BZWxwchAqejk7",
  },
  {
    label: "Apple Music",
    href: "https://music.apple.com/ca/album/lego-blocks/6819093443?i=6819093444",
  },
];
---

<Layout
  title="Lego Blocks | Alec Ray Sherman"
  description="Lego Blocks, the new single from Alec Ray Sherman. Out now on Spotify and Apple Music."
  image={ogImage.src}
>
  <section class="mx-auto max-w-5xl px-6 py-8 md:py-20">
    <div class="grid items-center gap-6 md:grid-cols-2 md:gap-12">
      <Image
        src={cover}
        alt="Lego Blocks single cover"
        widths={[400, 800, 1200]}
        sizes="(min-width: 768px) 50vw, 100vw"
        class="aspect-square w-3/5 rounded-sm object-cover shadow-md md:w-full"
        loading="eager"
      />
      <div>
        <p
          class="text-sm uppercase tracking-widest text-neutral-500"
          style="font-family: 'Questrial', system-ui, sans-serif;"
        >
          New single
        </p>
        <h1
          class="mt-3 text-5xl font-normal leading-tight tracking-wide sm:text-6xl"
          style="font-family: 'Questrial', system-ui, sans-serif;"
        >
          Lego Blocks
        </h1>
        <p class="mt-2 text-lg text-neutral-700">Alec Ray Sherman</p>

        <div class="mt-6 flex flex-col gap-3 sm:max-w-xs md:mt-10">
          {
            listenLinks.map((l) => (
              <a
                href={l.href}
                target="_blank"
                rel="noreferrer"
                data-listen={l.label}
                class="rounded-full px-7 py-3 text-center text-sm uppercase tracking-widest text-white transition hover:opacity-90"
                style="background-color: #ff8044; font-family: 'Questrial', system-ui, sans-serif;"
              >
                Listen on {l.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    document.querySelectorAll("[data-listen]").forEach((a) =>
      a.addEventListener("click", () => {
        if (window.fbq) fbq("trackCustom", "ListenClick", { platform: a.dataset.listen, release: "Lego Blocks" });
      }),
    );
  </script>
</Layout>
