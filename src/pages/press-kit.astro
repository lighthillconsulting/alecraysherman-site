---
import Layout from "../layouts/Layout.astro";

const pressClippings = [
  { name: "Bored City", url: "#" },
  { name: "Right Chord Music", url: "#" },
  { name: "Roadie Music", url: "#" },
  { name: "Dropout Entertainment", url: "#" },
];
---

<Layout title="Press Kit — Alec Ray Sherman">
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="text-4xl font-semibold tracking-tight">Press Kit</h1>
    <p class="mt-6 text-lg text-neutral-700">
      Press appearances and a photo gallery. You may notice a theme of
      heart-shaped glasses throughout — indicative of the title of the record:
      <em>Rose Coloured Glasses</em>.
    </p>

    <h2 class="mt-16 text-2xl font-semibold tracking-tight">Show Videos</h2>
    <p class="mt-3 text-neutral-600">
      Performance clips coming soon — Lee's Palace (Aug 4, 2023) and Supermarket
      Bar &amp; Variety (Aug 8, 2023).
    </p>

    <h2 class="mt-16 text-2xl font-semibold tracking-tight">Press Clippings</h2>
    <ul class="mt-6 space-y-3">
      {
        pressClippings.map((p) => (
          <li>
            <a
              class="underline-offset-4 hover:underline"
              href={p.url}
              target="_blank"
              rel="noreferrer"
            >
              {p.name}
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="mt-16 text-2xl font-semibold tracking-tight">Action Shots</h2>
    <p class="mt-3 text-neutral-600">Concert photo gallery coming soon.</p>
  </section>
</Layout>
