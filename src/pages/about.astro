---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import beachman from "../assets/about-beachman.jpg";
import concert from "../assets/about-concert.jpg";
import aux from "../assets/about-aux.jpg";

const pressQuotes = [
  {
    quote:
      "These songs sound uniquely amazing and everyone should be excited to hear them.",
    source: "Jon Savard, producer, RHC Music Toronto",
  },
  {
    quote:
      "He brightens the alternative rock scene with his sound full of emotion and talent.",
    source: "Right Chord Music",
  },
  {
    quote:
      "'One Night' is an absolute banger – it bursts with life and energy!",
    source: "Right Chord Music",
    href: "https://www.rightchordmusic.co.uk/alec-ray-sherman-one-night/",
  },
  {
    quote:
      "Through his heartfelt delivery and introspective lyricism, he allows listeners to immerse themselves in their own experiences of love, loss, and personal growth.",
    source: "Bored City",
    href: "https://boredcity.co/alec-ray-sherman-headlights/",
  },
];

const additionalPressLinks = [
  {
    label: "Roadie-music.com",
    href: "https://roadie-music.com/alec-ray-sherman-confira-novo-single-one-night/",
  },
];
---

<Layout title="About | Alec Ray Sherman">
  <section class="mx-auto max-w-3xl px-6 py-20">
    <h1
      class="text-5xl font-normal tracking-wide"
      style="font-family: 'Questrial', system-ui, sans-serif;"
    >
      Meet Alec
    </h1>

    <div class="mt-10 space-y-5 text-base leading-relaxed text-neutral-800">
      <p>
        Alec is a Toronto-based singer-songwriter who captivates audiences with
        his dynamic range of emotive and powerful tracks. From the sappiest of
        love songs to the most rousing anthems, Alec has a way of connecting
        with listeners through his sincere lyrics and captivating stage
        presence.
      </p>
      <p>
        As a natural performer, Alec has worked some of the most renowned stages
        in the country, including solo &amp; full-band performances at Massey
        Hall, Lee's Palace, the Horseshoe Tavern, Supermarket, and The Ivy. He's
        made a name for himself at Indie Week &amp; Departure Fest, performing
        in the 2018 and 2019 lineups to packed rooms singing along.
      </p>
      <p>
        Alec released his debut record <em>Rose Coloured Glasses</em> in July
        2023. This collection of uniquely emotive personal stories takes sonic
        inspiration from fun., The Band CAMINO, Valley, Marianas Trench, and
        other pop contemporaries. Produced and mixed at RHC Music in downtown
        Toronto, the record has already amassed international press and over
        20,000 plays on Spotify alone.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-3">
      <Image
        src={aux}
        alt="Portrait"
        widths={[300, 600]}
        sizes="(min-width: 640px) 33vw, 100vw"
        class="aspect-[116/168] w-full rounded-sm object-cover"
      />
      <Image
        src={beachman}
        alt="Live performance"
        widths={[300, 600]}
        sizes="(min-width: 640px) 33vw, 100vw"
        class="aspect-[302/382] w-full rounded-sm object-cover"
      />
      <Image
        src={concert}
        alt="Live performance"
        widths={[300, 600]}
        sizes="(min-width: 640px) 33vw, 100vw"
        class="aspect-[302/210] w-full rounded-sm object-cover"
      />
    </div>

    <h2
      class="mt-20 text-3xl font-normal tracking-wide"
      style="font-family: 'Questrial', system-ui, sans-serif;"
    >
      Press
    </h2>
    <ul class="mt-8 space-y-8">
      {
        pressQuotes.map((q) => (
          <li class="border-l-4 pl-5" style="border-color: #ff8044;">
            <p class="text-lg italic text-neutral-800">"{q.quote}"</p>
            <p class="mt-2 text-sm text-neutral-600">
              — {q.source}
              {q.href && (
                <>
                  {" · "}
                  <a
                    class="underline-offset-4 hover:underline"
                    href={q.href}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Read more here
                  </a>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>

    <ul class="mt-8 space-y-2 text-sm text-neutral-600">
      {
        additionalPressLinks.map((p) => (
          <li>
            <a
              class="underline-offset-4 hover:underline"
              href={p.href}
              target="_blank"
              rel="noreferrer"
            >
              {p.label} — Read more here
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
